      "item": [
        {
          "id": "be3864b3-7c9d-4c19-862e-b31a730fabd3",
          "name": "Get a paginated list of user roles",
          "request": {
            "name": "Get a paginated list of user roles",
            "description": {
              "content": "Returns a paginated list of **direct** user roles. Only shows roles\nexplicitly granted on accounts, investing entities, or holdings.\nAccess inherited via parent folders is not expanded into this list.\n\nEach returned role identifies its target via a single `objectRef` (an `AccountRef`,\n`InvestingEntityRef`, or `HoldingRef`) along with an `objectType` discriminator. The\nlegacy `accountId` and `userUrl` fields are still populated where applicable but are\ndeprecated; new integrations should read `objectRef` and `userRef` instead.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "client-api",
                "v0",
                "user-roles"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "The number of user roles to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "The number of user roles to skip before collecting results"
                },
                {
                  "disabled": false,
                  "key": "accountIds",
                  "value": "<integer>",
                  "description": "Only include roles on one of the account ids provided. Applies only to roles where `objectType` is `account`."
                },
                {
                  "disabled": false,
                  "key": "accountIds",
                  "value": "<integer>",
                  "description": "Only include roles on one of the account ids provided. Applies only to roles where `objectType` is `account`."
                },
                {
                  "disabled": false,
                  "key": "investingEntityIds",
                  "value": "<integer>",
                  "description": "Only include roles on one of the investing entity ids provided. Applies only to roles where `objectType` is `investingEntity`."
                },
                {
                  "disabled": false,
                  "key": "investingEntityIds",
                  "value": "<integer>",
                  "description": "Only include roles on one of the investing entity ids provided. Applies only to roles where `objectType` is `investingEntity`."
                },
                {
                  "disabled": false,
                  "key": "userIds",
                  "value": "<integer>",
                  "description": "Only include roles on one of the user ids provided."
                },
                {
                  "disabled": false,
                  "key": "userIds",
                  "value": "<integer>",
                  "description": "Only include roles on one of the user ids provided."
                },
                {
                  "disabled": false,
                  "key": "objectType",
                  "value": "<string>",
                  "description": "Which type of object to include. Allowed values: `account` or `investingEntity`.\n\n**This field defaults to `account` for backwards compatibility.** Callers that want\ninvesting-entity or holding roles must provide this parameter.\n"
                },
                {
                  "disabled": false,
                  "key": "objectType",
                  "value": "<string>",
                  "description": "Which type of object to include. Allowed values: `account` or `investingEntity`.\n\n**This field defaults to `account` for backwards compatibility.** Callers that want\ninvesting-entity or holding roles must provide this parameter.\n"
                },
                {
                  "disabled": false,
                  "key": "roleType",
                  "value": "<string>",
                  "description": "Filter results to only include roles matching the specified portal name.\nSpaces and special characters must be URL-encoded.\n\nExample values (as they appear in the database):\n- `Tax Only` (in URL: `?roleType=Tax%20Only`)\n- `Full Access` (in URL: `?roleType=Full%20Access`)\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
